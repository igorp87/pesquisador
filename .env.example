# Copie este arquivo para .env.local e preencha as chaves que tiver.
# Fontes sem chave são puladas automaticamente (exceto Hacker News, que é aberta).

# Claude — análise/relatório (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=

# Google Search — use UM dos dois:
# Serper.dev (2.500 buscas grátis): https://serper.dev
SERPER_API_KEY=
# SerpAPI (também habilita Google Trends): https://serpapi.com
SERPAPI_KEY=

# Reddit — opcional. Sem credenciais o app usa os endpoints públicos .json
# (funcionam, mas com limite baixo e podem ser bloqueados em IPs de nuvem).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Formato recomendado pelo Reddit: <plataforma>:<app id>:<versão> (by /u/<seu usuário>)
REDDIT_USER_AGENT=web:pesquisador:v0.1 (by /u/seu_usuario)
